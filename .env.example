# CAPTURE_IFACE：监听的网卡名（抓包镜像口）
# 查看网卡名：ip link show
CAPTURE_IFACE=eth0
CAPTURE_AUTH=1
CAPTURE_ACCOUNTING=0
WRITE_ACCOUNTING_LOG=0
ACCT_INTERIM_SAMPLE_SECONDS=60
AUTH_WRITER_BATCH_SIZE=1000
AUTH_REALTIME_WRITER_BATCH_SIZE=1000
AUTH_RISK_WRITER_BATCH_SIZE=2000
ACCT_WRITER_BATCH_SIZE=2000
WRITER_QUEUE_SIZE=50000

# MySQL（一般不需要修改，与 docker-compose.yml 一致）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=radius_monitor
MYSQL_USER=radius
MYSQL_PASS=radius123

# 可选：多终端派生汇总会增加高流量下的写库压力，默认关闭
UPDATE_USER_MAC_SUMMARY=0
WRITE_AUTH_RISK=0
RETAIN_DAYS=30
ACCT_RETAIN_DAYS=30
ACCT_CLEANUP_BATCH_SIZE=1000
AUTH_CLEANUP_BATCH_SIZE=5000
AUTH_CLEANUP_MAX_BATCHES=10
AUTH_USER_RETAIN_DAYS=1
AUTH_USER_MAC_RETAIN_DAYS=3

# 可选：排除已知不完整的历史采集区间，格式 YYYY-MM-DD HH:MM:SS
REPORT_VALID_FROM=
